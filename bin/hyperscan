#!/bin/sh

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
binary=$repo_root/build/hyperscan/bin/hyperscan
system=$(uname -s) || exit 1
machine=$(uname -m) || exit 1

case "$system:$machine" in
  Darwin:x86_64|Linux:x86_64)
    runner=
    ;;
  Darwin:arm64)
    if ! /usr/bin/arch -x86_64 /usr/bin/true >/dev/null 2>&1; then
      echo 'hyperscan: Rosetta 2 is required to run the x86_64 build' >&2
      exit 1
    fi
    runner=/usr/bin/arch
    ;;
  *)
    echo "hyperscan: unsupported platform: $system $machine (x86_64 Linux or macOS is required)" >&2
    exit 1
    ;;
esac

if [ ! -x "$binary" ]; then
  echo 'hyperscan: build/hyperscan/bin/hyperscan is missing or not executable' >&2
  echo 'hyperscan: run the Conan and CMake commands in README.md under "Hyperscan setup"' >&2
  exit 1
fi

if [ -n "$runner" ]; then
  exec "$runner" -x86_64 "$binary" "$@"
fi
exec "$binary" "$@"
